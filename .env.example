# Elevator Equipment Wholesale — Environment Variables

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.user:password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connection pooler URL (port 6543) for Prisma Client queries via pgBouncer.
# Replace "user" and "password" with your Supabase project credentials.

DIRECT_URL="postgresql://postgres.user:password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# Direct connection URL (port 5432) for Prisma Migrate / db push.
# pgBouncer is NOT compatible with DDL operations, so migrations must use
# a direct connection.

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or: openssl rand -base64 32
# Used to encrypt JWT tokens and session cookies.
# ⚠️ Must be at least 32 characters. Do not reuse the default example value in production.

NEXTAUTH_URL="https://your-app.vercel.app"
# Full URL of your production deployment. Must match the domain Vercel assigns
# or your custom domain.

# ─── Supabase (Database Hosting) ─────────────────────────────────────────────
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Public anon key from Project Settings → API.

SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Secret service role key from Project Settings → API.
# ⚠️ Never expose this on the client side.

# ─── Resend (Email Service) ──────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
# API key from https://resend.com/api-keys.
# Used to send quotation notification emails to admins.

ADMIN_EMAIL="admin@example.com"
# Email address that receives new quotation notifications.

EMAIL_FROM="Elevator Equipment <noreply@elevatorequipment.com>"
# Sender address for outgoing emails. Must be verified in Resend.

# ─── Cloudflare R2 (File Storage) ────────────────────────────────────────────
R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2 access key ID from Cloudflare Dashboard → R2 → Manage API Tokens.

R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2 secret access key.

R2_BUCKET_NAME="elevator-equipment-uploads"
# Name of the R2 bucket for product images and PDF documents.

R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"
# Public URL for the R2 bucket. Used for serving uploaded files.

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"
# Public base URL used for constructing absolute URLs in emails and sitemaps.
# In production, should match NEXTAUTH_URL.
