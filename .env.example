# Elevator Equipment Wholesale — 环境变量模板
#
# ⚠️ 真实值只放两处：本地 `.env`（不进 git）和 Hostinger 面板的环境变量。
#    本文件只写"有哪些键、干什么用的"，不放任何真实凭据。
#
# 当前线上部署：Hostinger 共享主机 + MySQL（不是 Vercel / Supabase，
# 旧版本文档里的 Supabase / Resend / R2 / Upstash 都是废弃方案，已删）。

# ─── 数据库（Hostinger MySQL）─────────────────────────────────────────────────
DATABASE_URL="mysql://用户名:密码@主机:3306/u899509956_elevator_db"
# Prisma datasource = mysql。Hostinger 的库名形如 u<账号号>_<库名>。

# ─── 站点地址 ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://quickeaseliftparts.com"
# 用于 sitemap / canonical / OpenGraph 的绝对 URL。

# ─── 邮件通知（询盘提醒，nodemailer）────────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@quickeaseliftparts.com"
SMTP_PASS="<邮箱密码>"
NOTIFY_EMAIL="info@quickeaseliftparts.com,sales@quickeaseliftparts.com"
# 新询盘会发到这个地址。⚠️ 这是 best-effort：发失败不会影响表单提交，
#    失败会以 [CONTACT-EMAIL-FAILED] 前缀写进服务器日志。
#    兜底入口：后台 /admin/messages 能看到全部询盘（不依赖邮件）。

# ─── 流量分析（不配就不加载任何第三方脚本）──────────────────────────────────
GA_ID="G-XXXXXXXXXX"
# Google Analytics 4 的媒体资源 ID（analytics.google.com → 管理 → 数据流 → 衡量 ID）。
# ⚠️ 故意不用 NEXT_PUBLIC_ 前缀 + 服务端 SSR 输出，
#    所以改完面板环境变量"重启应用"即生效，不需要重新 build。
#    （NEXT_PUBLIC_ 变量是构建时内联的，面板里改了等于没改）

GSC_VERIFICATION="<Search Console 的 HTML 标记验证码>"
# Google Search Console → 添加资源 → HTML 标记方式 → 复制 content="..." 里的那串。
# 配好后首页会输出 <meta name="google-site-verification" content="...">。

# ─── 管理后台 ────────────────────────────────────────────────────────────────
ADMIN_PASSWORD="<后台密码>"
# /admin/login 使用；同时会写入 admin_token cookie。
